#!/usr/bin/env bash

set -Eeuo pipefail

PROGRAM_NAME="$(basename "$0")"

usage() {
  cat <<EOF
Usage:
  $PROGRAM_NAME [--src INPUT_DIR] [--out OUTPUT_DIR] [--from FORMAT] [--to FORMAT | --target NAME] [--dry-run] [--force] [--manifest [PATH]] [--quarantine DIR] [--quarantine-copy]
  $PROGRAM_NAME [--src INPUT_DIR] [--preflight]

Description:
  Bulk-convert ebook files using Calibre / ebook-convert.

  Defaults are EPUB to AZW3, matching the historical bulk-epub-to-azw3 behavior.

Defaults:
  --src      current working directory
  --from     epub
  --to       azw3
  --out      ./<to> inside the current working directory (./azw3 by default)

Examples:
  $PROGRAM_NAME --dry-run
  $PROGRAM_NAME
  $PROGRAM_NAME --from epub --to azw3
  $PROGRAM_NAME --from mobi --to epub --src ./mobi --out ./epub
  $PROGRAM_NAME --target kindle --src ./epub --dry-run
  $PROGRAM_NAME --target archive --src ./epub --out ./archive
  $PROGRAM_NAME --src ./epub --out ./kindle --dry-run
  $PROGRAM_NAME --src ./epub --preflight
  $PROGRAM_NAME --src ./epub --out ./kindle --manifest
  $PROGRAM_NAME --src ./epub --out ./kindle --quarantine ./review

Options:
  --src              Source directory. Default: current working directory
  --from             Source ebook format extension. Default: epub
  --to               Target ebook format extension. Default: azw3
  --target           Curated conversion target: kindle, kobo, archive, text
  --out              Output directory. Default: ./<to>
  --dry-run          Show what would be converted without creating output
  --force            Overwrite existing output files
  --manifest         Write a JSONL conversion manifest. Default path: OUT/conversion-manifest.jsonl
  --quarantine DIR   Record invalid or failed source files under DIR for review
  --quarantine-copy  Copy quarantined source files instead of creating symlinks
  --preflight        Inspect EPUB metadata without converting (requires --from epub)
  -h, --help         Show this help

Supported input formats:
  epub mobi azw azw3 pdf djvu docx doc txt html htm cbz cbr

Supported output formats:
  azw3 epub mobi pdf txt docx kepub

Curated targets:
  kindle -> azw3
  kobo -> kepub
  archive -> epub
  text -> txt
EOF
}

die() {
  echo "ERROR: $*" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "missing command: $1"
}

is_valid_epub() {
  local file="$1"
  local mimetype

  unzip -tqq "$file" >/dev/null 2>&1 || return 1

  mimetype="$(unzip -p "$file" mimetype 2>/dev/null || true)"
  [[ "$mimetype" == "application/epub+zip" ]] || return 1

  unzip -Z -1 "$file" 2>/dev/null | grep -qx 'META-INF/container.xml' || return 1

  return 0
}

normalize_format() {
  local value="${1#/}"
  value="${value,,}"

  [[ "$value" =~ ^[a-z0-9][a-z0-9_-]*$ ]] || die "invalid format: $1"

  printf '%s' "$value"
}

SUPPORTED_FROM_FORMATS=(
  epub mobi azw azw3 pdf djvu docx doc txt html htm cbz cbr
)

SUPPORTED_TO_FORMATS=(
  azw3 epub mobi pdf txt docx kepub
)

resolve_conversion_target() {
  local value="${1,,}"

  case "$value" in
    kindle)
      TARGET="kindle"
      TO="azw3"
      ;;
    kobo)
      TARGET="kobo"
      TO="kepub"
      ;;
    archive)
      TARGET="archive"
      TO="epub"
      ;;
    text)
      TARGET="text"
      TO="txt"
      ;;
    *)
      die "unknown target: $1"
      ;;
  esac
}

format_supported() {
  local format="$1"
  shift
  local allowed

  for allowed in "$@"; do
    if [[ "$format" == "$allowed" ]]; then
      return 0
    fi
  done

  return 1
}

validate_format_allowlist() {
  if ! format_supported "$FROM" "${SUPPORTED_FROM_FORMATS[@]}"; then
    die "unsupported source format: $FROM"
  fi

  if ! format_supported "$TO" "${SUPPORTED_TO_FORMATS[@]}"; then
    die "unsupported target format: $TO"
  fi
}

emit_source_quality_notices() {
  case "$FROM" in
    pdf)
      echo "WARNING: PDF is often a poor source for ebook conversion"
      ;;
    djvu)
      echo "NOTE: DJVU conversion quality depends on an embedded text layer"
      ;;
  esac
}

is_valid_source() {
  local file="$1"

  case "$FROM" in
    epub)
      is_valid_epub "$file"
      ;;
    *)
      [[ -f "$file" && -r "$file" ]]
      ;;
  esac
}

invalid_source_message() {
  if [[ "$FROM" == "epub" ]]; then
    printf '%s' "not a valid EPUB"
  else
    printf 'not a valid %s file' "$FROM"
  fi
}

epub_preflight_report() {
  local file="$1"

  python3 - "$file" <<'PYCODE'
from __future__ import annotations

import sys
import zipfile
import xml.etree.ElementTree as ET
from pathlib import PurePosixPath


CONTAINER_NS = {"c": "urn:oasis:names:tc:opendocument:xmlns:container"}
OPF_NS = {
    "opf": "http://www.idpf.org/2007/opf",
    "dc": "http://purl.org/dc/elements/1.1/",
}


def local_name(tag: str) -> str:
    if "}" in tag:
        return tag.rsplit("}", 1)[1]
    return tag


def clean_text(value: str | None) -> str:
    if value is None:
        return ""
    return " ".join(value.split())


def first_dc_text(root: ET.Element, name: str) -> str:
    for element in root.iter():
        if local_name(element.tag) == name and element.tag.startswith("{http://purl.org/dc/elements/1.1/}"):
            text = clean_text(element.text)
            if text:
                return text
    return ""


def find_opf_path(archive: zipfile.ZipFile) -> str:
    container_xml = archive.read("META-INF/container.xml")
    container = ET.fromstring(container_xml)
    rootfile = container.find(".//c:rootfile", CONTAINER_NS)

    if rootfile is None:
        return ""

    return rootfile.attrib.get("full-path", "").strip()


def iter_manifest_items(root: ET.Element) -> list[ET.Element]:
    return [element for element in root.iter() if local_name(element.tag) == "item"]


def count_spine_items(root: ET.Element) -> int:
    return sum(1 for element in root.iter() if local_name(element.tag) == "itemref")


def detect_cover(root: ET.Element, opf_path: str, archive: zipfile.ZipFile) -> bool:
    manifest_items = iter_manifest_items(root)

    cover_id = ""

    for element in root.iter():
        if local_name(element.tag) == "meta" and element.attrib.get("name") == "cover":
            cover_id = element.attrib.get("content", "").strip()
            break

    for item in manifest_items:
        item_id = item.attrib.get("id", "")
        href = item.attrib.get("href", "")
        media_type = item.attrib.get("media-type", "")
        properties = item.attrib.get("properties", "")

        if cover_id and item_id == cover_id:
            return True

        if "cover-image" in properties.split():
            return True

        if media_type.startswith("image/") and "cover" in f"{item_id} {href}".lower():
            return True

        if media_type.startswith("image/") and href:
            opf_dir = PurePosixPath(opf_path).parent
            image_path = str(opf_dir / href)
            if image_path in archive.namelist() and "cover" in image_path.lower():
                return True

    return False


def main() -> int:
    epub_path = sys.argv[1]

    warnings: list[str] = []

    try:
        with zipfile.ZipFile(epub_path) as archive:
            opf_path = find_opf_path(archive)

            if not opf_path:
                print("OPF: (missing)")
                print("Title: (missing)")
                print("Creator: (missing)")
                print("Language: (missing)")
                print("Identifier: (missing)")
                print("Cover: no")
                print("Spine items: 0")
                print("Warnings:")
                print("- missing OPF package path in META-INF/container.xml")
                return 0

            opf_root = ET.fromstring(archive.read(opf_path))

            title = first_dc_text(opf_root, "title")
            creator = first_dc_text(opf_root, "creator")
            language = first_dc_text(opf_root, "language")
            identifier = first_dc_text(opf_root, "identifier")
            spine_items = count_spine_items(opf_root)
            has_cover = detect_cover(opf_root, opf_path, archive)

            if not title:
                warnings.append("missing title")
            if not creator:
                warnings.append("missing creator")
            if not language:
                warnings.append("missing language")
            if not identifier:
                warnings.append("missing identifier")
            if not has_cover:
                warnings.append("cover not detected")
            if spine_items == 0:
                warnings.append("empty spine")

            print(f"OPF: {opf_path}")
            print(f"Title: {title or '(missing)'}")
            print(f"Creator: {creator or '(missing)'}")
            print(f"Language: {language or '(missing)'}")
            print(f"Identifier: {identifier or '(missing)'}")
            print(f"Cover: {'yes' if has_cover else 'no'}")
            print(f"Spine items: {spine_items}")

            if warnings:
                print("Warnings:")
                for warning in warnings:
                    print(f"- {warning}")
            else:
                print("Warnings: none")

            return 0

    except (KeyError, ET.ParseError, zipfile.BadZipFile) as exc:
        print("OPF: (unreadable)")
        print(f"Warnings:\n- metadata audit failed: {exc}")
        return 0


if __name__ == "__main__":
    raise SystemExit(main())
PYCODE
}

file_size_bytes() {
  local file="$1"

  stat -c '%s' "$file" 2>/dev/null || true
}

file_sha256() {
  local file="$1"

  sha256sum "$file" | awk '{print $1}'
}

manifest_write_record() {
  local source_rel="$1"
  local output_rel="$2"
  local status="$3"
  local reason="${4:-}"
  local log_path="${5:-}"
  local src_file="$6"
  local out_file="${7:-}"

  local source_size=""
  local source_sha256=""
  local output_size=""
  local output_sha256=""

  if [[ -f "$src_file" ]]; then
    source_size="$(file_size_bytes "$src_file")"
    source_sha256="$(file_sha256 "$src_file")"
  fi

  if [[ -n "$out_file" && -f "$out_file" ]]; then
    output_size="$(file_size_bytes "$out_file")"
    output_sha256="$(file_sha256 "$out_file")"
  fi

  MF_SOURCE="$source_rel" \
  MF_OUTPUT="$output_rel" \
  MF_STATUS="$status" \
  MF_SOURCE_SIZE="$source_size" \
  MF_SOURCE_SHA256="$source_sha256" \
  MF_OUTPUT_SIZE="$output_size" \
  MF_OUTPUT_SHA256="$output_sha256" \
  MF_TIMESTAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  MF_EBOOK_CONVERT_VERSION="$EBOOK_CONVERT_VERSION" \
  MF_LOG_PATH="$log_path" \
  MF_REASON="$reason" \
  python3 - >>"$MANIFEST" <<'PY'
import json
import os


def optional_int(value: str) -> int | None:
    if not value:
        return None
    return int(value)


record = {
    "source": os.environ["MF_SOURCE"],
    "output": os.environ["MF_OUTPUT"],
    "status": os.environ["MF_STATUS"],
    "timestamp": os.environ["MF_TIMESTAMP"],
}

source_size = optional_int(os.environ.get("MF_SOURCE_SIZE", ""))
if source_size is not None:
    record["source_size"] = source_size

source_sha = os.environ.get("MF_SOURCE_SHA256", "")
if source_sha:
    record["source_sha256"] = source_sha

output_size = optional_int(os.environ.get("MF_OUTPUT_SIZE", ""))
if output_size is not None:
    record["output_size"] = output_size

output_sha = os.environ.get("MF_OUTPUT_SHA256", "")
if output_sha:
    record["output_sha256"] = output_sha

version = os.environ.get("MF_EBOOK_CONVERT_VERSION", "")
if version:
    record["ebook_convert_version"] = version

log_path = os.environ.get("MF_LOG_PATH", "")
if log_path:
    record["log_path"] = log_path

reason = os.environ.get("MF_REASON", "")
if reason:
    record["reason"] = reason

print(json.dumps(record, ensure_ascii=False))
PY
}

quarantine_attach_source() {
  local entry_dir="$1"
  local source_file="$2"

  if [[ "$QUARANTINE_COPY" -eq 1 ]]; then
    cp -a "$source_file" "$entry_dir/source.epub"
  elif ! ln -s "$source_file" "$entry_dir/source.epub" 2>/dev/null; then
    echo "  QUARANTINE: symlink unavailable for $source_file" >&2
  fi
}

quarantine_record() {
  local kind="$1"
  local rel="$2"
  local source_file="$3"
  local reason="$4"
  local log_file="${5:-}"

  local entry_dir="$QUARANTINE/$kind/$rel"

  mkdir -p "$entry_dir"

  printf '%s\n' "$reason" >"$entry_dir/reason.txt"
  printf '%s\n' "$rel" >"$entry_dir/source.path"
  quarantine_attach_source "$entry_dir" "$source_file"

  if [[ -n "$log_file" && -f "$log_file" ]]; then
    cp -a "$log_file" "$entry_dir/convert.log"
  fi
}

SRC="$PWD"
OUT=""
OUT_EXPLICIT=0
FROM=epub
TO=azw3
TO_EXPLICIT=0
TARGET=""
DRY_RUN=0
FORCE=0
PREFLIGHT=0
MANIFEST_ENABLED=0
MANIFEST=""
QUARANTINE_ENABLED=0
QUARANTINE=""
QUARANTINE_COPY=0
EBOOK_CONVERT_VERSION=""
INVALID_REASON=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --src)
      [[ $# -ge 2 ]] || die "missing value for --src"
      SRC="$2"
      shift 2
      ;;
    --src=*)
      SRC="${1#--src=}"
      shift
      ;;
    --out)
      [[ $# -ge 2 ]] || die "missing value for --out"
      OUT="$2"
      OUT_EXPLICIT=1
      shift 2
      ;;
    --out=*)
      OUT="${1#--out=}"
      OUT_EXPLICIT=1
      shift
      ;;
    --from)
      [[ $# -ge 2 ]] || die "missing value for --from"
      FROM="$2"
      shift 2
      ;;
    --from=*)
      FROM="${1#--from=}"
      shift
      ;;
    --to)
      [[ $# -ge 2 ]] || die "missing value for --to"
      TO="$2"
      TO_EXPLICIT=1
      shift 2
      ;;
    --to=*)
      TO="${1#--to=}"
      TO_EXPLICIT=1
      shift
      ;;
    --target)
      [[ $# -ge 2 ]] || die "missing value for --target"
      if [[ -n "$TARGET" ]]; then
        die "duplicate --target option"
      fi
      resolve_conversion_target "$2"
      shift 2
      ;;
    --target=*)
      if [[ -n "$TARGET" ]]; then
        die "duplicate --target option"
      fi
      resolve_conversion_target "${1#--target=}"
      shift
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --force)
      FORCE=1
      shift
      ;;
    --preflight)
      PREFLIGHT=1
      shift
      ;;
    --manifest)
      MANIFEST_ENABLED=1
      if [[ $# -ge 2 && "$2" != -* ]]; then
        MANIFEST="$2"
        shift 2
      else
        shift
      fi
      ;;
    --manifest=*)
      MANIFEST="${1#--manifest=}"
      MANIFEST_ENABLED=1
      shift
      ;;
    --quarantine)
      [[ $# -ge 2 ]] || die "missing value for --quarantine"
      QUARANTINE="$2"
      QUARANTINE_ENABLED=1
      shift 2
      ;;
    --quarantine=*)
      QUARANTINE="${1#--quarantine=}"
      QUARANTINE_ENABLED=1
      shift
      ;;
    --quarantine-copy)
      QUARANTINE_COPY=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

if [[ -n "$TARGET" && "$TO_EXPLICIT" -eq 1 ]]; then
  die "--target and --to are mutually exclusive"
fi

FROM="$(normalize_format "$FROM")"
TO="$(normalize_format "$TO")"
INVALID_REASON="$(invalid_source_message)"

validate_format_allowlist

if [[ "$OUT_EXPLICIT" -eq 0 ]]; then
  OUT="$PWD/$TO"
fi

need_cmd find
need_cmd realpath

if [[ "$FROM" == "epub" || "$PREFLIGHT" -eq 1 ]]; then
  need_cmd unzip
  need_cmd grep
fi

if [[ "$PREFLIGHT" -eq 1 ]]; then
  need_cmd python3
fi

if [[ "$MANIFEST_ENABLED" -eq 1 ]]; then
  need_cmd python3
  need_cmd sha256sum
  need_cmd date
fi

if [[ "$PREFLIGHT" -eq 0 && "$DRY_RUN" -eq 0 ]]; then
  need_cmd ebook-convert
fi

[[ "$PREFLIGHT" -eq 0 || "$MANIFEST_ENABLED" -eq 0 ]] || die "--manifest cannot be used with --preflight"
[[ "$PREFLIGHT" -eq 0 || "$QUARANTINE_ENABLED" -eq 0 ]] || die "--quarantine cannot be used with --preflight"
[[ "$PREFLIGHT" -eq 0 || "$FROM" == "epub" ]] || die "--preflight requires --from epub"
[[ "$QUARANTINE_COPY" -eq 0 || "$QUARANTINE_ENABLED" -eq 1 ]] || die "--quarantine-copy requires --quarantine"

[[ -d "$SRC" ]] || die "source directory does not exist: $SRC"

SRC="$(realpath "$SRC")"
OUT="$(realpath -m "$OUT")"

if [[ "$MANIFEST_ENABLED" -eq 1 ]]; then
  if [[ -z "$MANIFEST" ]]; then
    MANIFEST="$OUT/conversion-manifest.jsonl"
  fi
  MANIFEST="$(realpath -m "$MANIFEST")"
fi

if [[ "$QUARANTINE_ENABLED" -eq 1 ]]; then
  QUARANTINE="$(realpath -m "$QUARANTINE")"
fi

[[ "$SRC" != "$OUT" ]] || die "SRC and OUT must not be the same directory."

total=0
valid=0
invalid=0
preflighted=0
converted=0
skipped=0
failed=0

echo "SRC: $SRC"
echo "OUT: $OUT"
echo "FROM: $FROM"
if [[ -n "$TARGET" ]]; then
  echo "TARGET: $TARGET"
fi
echo "TO: $TO"

if [[ "$PREFLIGHT" -eq 0 ]]; then
  emit_source_quality_notices
fi

if [[ "$PREFLIGHT" -eq 1 ]]; then
  echo "Mode: PREFLIGHT"
elif [[ "$DRY_RUN" -eq 1 ]]; then
  echo "Mode: DRY-RUN"
else
  echo "Mode: REAL CONVERSION"
  mkdir -p "$OUT"
fi

if [[ "$MANIFEST_ENABLED" -eq 1 ]]; then
  if [[ "$DRY_RUN" -eq 0 ]]; then
    EBOOK_CONVERT_VERSION="$(ebook-convert --version 2>/dev/null | head -n1 || true)"
  fi
  mkdir -p "$(dirname "$MANIFEST")"
  : >"$MANIFEST"
  echo "Manifest: $MANIFEST"
fi

if [[ "$QUARANTINE_ENABLED" -eq 1 && "$PREFLIGHT" -eq 0 && "$DRY_RUN" -eq 0 ]]; then
  mkdir -p "$QUARANTINE"
  echo "Quarantine: $QUARANTINE"
fi

echo

while IFS= read -r -d '' file; do
  total=$((total + 1))

  rel="${file#"$SRC"/}"
  out_rel="${rel%.*}.${TO}"
  dest="$OUT/$out_rel"

  echo "File: $rel"

  if ! is_valid_source "$file"; then
    echo "  INVALID: $INVALID_REASON"
    invalid=$((invalid + 1))
    if [[ "$MANIFEST_ENABLED" -eq 1 ]]; then
      manifest_write_record "$rel" "$out_rel" "invalid" "$INVALID_REASON" "" "$file" ""
    fi
    if [[ "$QUARANTINE_ENABLED" -eq 1 && "$PREFLIGHT" -eq 0 && "$DRY_RUN" -eq 0 ]]; then
      quarantine_record "invalid" "$rel" "$file" "$INVALID_REASON"
    fi
    echo
    continue
  fi

  valid=$((valid + 1))

  if [[ "$PREFLIGHT" -eq 1 ]]; then
    epub_preflight_report "$file" | sed 's/^/  /'
    preflighted=$((preflighted + 1))
    echo
    continue
  fi

  if [[ -f "$dest" && "$FORCE" -eq 0 ]]; then
    echo "  SKIP: already exists: $dest"
    skipped=$((skipped + 1))
    if [[ "$MANIFEST_ENABLED" -eq 1 ]]; then
      manifest_write_record "$rel" "$out_rel" "skipped" "already exists" "" "$file" "$dest"
    fi
    echo
    continue
  fi

  if [[ "$DRY_RUN" -eq 1 ]]; then
    echo "  DRY: ebook-convert \"$file\" \"$dest\""
    if [[ "$MANIFEST_ENABLED" -eq 1 ]]; then
      manifest_write_record "$rel" "$out_rel" "planned" "" "" "$file" ""
    fi
    echo
    continue
  fi

  mkdir -p "$(dirname "$dest")"

  tmp="${dest%."${TO}"}.tmp.$$.$TO"
  log="${dest%."${TO}"}.convert.log"

  echo "  CONVERT -> $dest"

  if ebook-convert "$file" "$tmp" >"$log" 2>&1; then
    mv -f "$tmp" "$dest"
    rm -f "$log"
    converted=$((converted + 1))
    if [[ "$MANIFEST_ENABLED" -eq 1 ]]; then
      manifest_write_record "$rel" "$out_rel" "converted" "" "" "$file" "$dest"
    fi
    echo "  OK"
  else
    rm -f "$tmp"
    failed=$((failed + 1))
    if [[ "$MANIFEST_ENABLED" -eq 1 ]]; then
      manifest_write_record "$rel" "$out_rel" "failed" "conversion failed" "$log" "$file" ""
    fi
    if [[ "$QUARANTINE_ENABLED" -eq 1 ]]; then
      quarantine_record "failed" "$rel" "$file" "conversion failed" "$log"
    fi
    echo "  FAILED: see log: $log"
  fi

  echo
done < <(find "$SRC" -type f -iname "*.${FROM}" -not -path "$OUT/*" -print0)

echo "Summary:"
if [[ "$FROM" == "epub" ]]; then
  echo "  EPUB found:      $total"
  echo "  EPUB valid:      $valid"
  echo "  EPUB invalid:    $invalid"
else
  echo "  Source found:    $total"
  echo "  Source valid:    $valid"
  echo "  Source invalid:  $invalid"
fi

if [[ "$PREFLIGHT" -eq 1 ]]; then
  echo "  Preflighted:     $preflighted"
else
  echo "  Converted:       $converted"
  echo "  Skipped:         $skipped"
  echo "  Failed:          $failed"
fi

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo
  echo "Dry-run completed. If the plan looks correct, run again without --dry-run."
fi

if [[ "$failed" -gt 0 ]]; then
  exit 2
fi
